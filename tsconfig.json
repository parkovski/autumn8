{
  "compilerOptions": {
    "target": "ES2016",
    "jsx": "react-jsx",
    "jsxImportSource": "jsx-dom",

    /* Modules */
    "module": "ES2020",
    "moduleResolution": "node",
    "rootDir": "./src",

    /* Emit */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,

    /* Interop Constraints */
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "preserveSymlinks": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,

    /* Completeness */
    "skipLibCheck": true
  }
}
