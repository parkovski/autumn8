set(A8_FLSTUDIO_PLATFORM OFF)
set(A8_VST3_PLATFORM OFF)
if(APPLE)
  if(CMAKE_SYSTEM_NAME MATCHES "Darwin")
    set(A8_PLATFORM "macOS")
    set(A8_DEFAULT_GFXBACKEND "Cocoa")
    set(A8_FLSTUDIO_PLATFORM ON)
    set(A8_VST3_PLATFORM ON)
    set(A8_AU_PLATFORM ON)
  elseif(CMAKE_SYSTEM_NAME MATCHES "iOS" OR CMAKE_SYSTEM_NAME MATCHES "iPhone OS")
    set(A8_PLATFORM "iOS")
    set(A8_GFXBACKEND "CocoaTouch")
    set(A8_AU_PLATFORM ON)
  else()
    message(FATAL_ERROR "Target ${CMAKE_SYSTEM_NAME} is not supported")
  endif()
elseif(WIN32)
  set(A8_PLATFORM "Windows")
  set(A8_DEFAULT_GFXBACKEND "Win32")
  set(A8_FLSTUDIO_PLATFORM ON)
  set(A8_VST3_PLATFORM ON)
  if(MSVC)
    add_compile_options("/utf-8")
  endif()
elseif(CMAKE_SYSTEM_NAME MATCHES "Android")
  set(A8_PLATFORM "Android")
  set(A8_GFXBACKEND "Android")
elseif(CMAKE_SYSTEM_NAME MATCHES "Linux")
  set(A8_PLATFORM "Linux")
  set(A8_DEFAULT_GFXBACKEND "Gtk")
  set(A8_VST3_PLATFORM ON)
  set(A8_LV2_PLATFORM ON)
elseif(CMAKE_SYSTEM_NAME MATCHES "Emscripten")
  set(A8_PLATFORM "Emscripten")
  set(A8_GFXBACKEND "HTML")
else()
  message(FATAL_ERROR "Target ${CMAKE_SYSTEM_NAME} is not supported")
endif()

if(NOT A8_GFXBACKEND)
  set(A8_GFXBACKEND ${A8_DEFAULT_GFXBACKEND})
endif()
